# STM32CubeIDE project and build artifacts
**/.metadata/
**/.settings/
**/.cproject
**/.project
**/Debug/
**/Release/
**/build/
*.elf
*.bin
*.hex
*.map
*.list
*.cyclo
*.su
*.d
*.log
# But keep bench UART captures committed alongside raw data
!data/raw/**/*.log

# STM32CubeIDE debug launch / OpenOCD configs (machine-specific paths)
firmware/STM32CubeIDE/**/*.launch
firmware/STM32CubeIDE/**/*.cfg

# Scratch / preview files
firmware/STM32CubeIDE/boot_sound_preview.html

# Hidden IDE caches
**/.plugins/
**/.snap
**/.indexes/
**/.history/

# OS-specific junk
.DS_Store
Thumbs.db
desktop.ini

# Python bytecode (e.g. hardware/scripts/, analysis/)
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Papermill execution artefacts (output notebooks; source is validation.ipynb)
analysis/notebooks/*_executed.ipynb

# Generated figures (regenerated from the notebook on every run; final
# versions committed manually before the submission tag once campaign
# data is in data/raw/).
analysis/figures/

# KiCad autosave and backups
hardware/_autosave-*.kicad_sch
hardware/_autosave-*.kicad_pcb
hardware/flow_monitor-backups/
hardware/fp-info-cache

# KiCad temp scratch folder
hardware/temp/

# Stray third-party 3D model folder (not part of this project)
hardware/3dmodels/Neuer Ordner/

# Claude Code local settings (personal/machine-specific, never commit)
.claude/settings.local.json

# KiCad skill scratch outputs (tool-generated, not source)
hardware/_*_analysis.json
hardware/sch_analysis.json

# KiCad per-user UI state (active layer, panel positions, etc.)
**/*.kicad_prl

# git-filter-repo configuration (history-scrub helper, not for repo)
.git-filter-repo-replace-text.txt

# SWD log reader runtime state (head pointer cache)
firmware/STM32CubeIDE/InfusionBA2/tools/.read_swd_log_state.json
