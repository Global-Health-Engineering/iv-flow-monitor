---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const REPO = 'https://github.com/Gluflex/iv-flow-monitor-v2';
const TREE = `${REPO}/tree/v2`;
const BLOB = `${REPO}/blob/v2`;
const BOM_CSV_URL = `${BLOB}/hardware/bom.csv.new`;

type BomRow = {
  group: string;
  ref: string;
  category: string;
  description: string;
  mfgPn: string;
  qtyPerUnit: number;
  priceUsd1: number | null;
  priceUsd1k: number | null;
};

const csvPath = fileURLToPath(new URL('../../../hardware/bom.csv.new', import.meta.url));
const csvText = readFileSync(csvPath, 'utf-8').trim();
const [headerLine, ...dataLines] = csvText.split(/\r?\n/);
const headers = headerLine.split(',');
const idx = (h: string) => headers.indexOf(h);

function num(s: string | undefined): number | null {
  if (!s || s.trim() === '') return null;
  const v = Number(s);
  return Number.isFinite(v) ? v : null;
}

const rows: BomRow[] = dataLines.map((line) => {
  const c = line.split(',');
  return {
    group: c[idx('group')] ?? '',
    ref: c[idx('ref')] ?? '',
    category: c[idx('category')] ?? '',
    description: c[idx('description')] ?? '',
    mfgPn: c[idx('mfg_pn')] ?? '',
    qtyPerUnit: Number(c[idx('qty_per_unit')]) || 1,
    priceUsd1: num(c[idx('price_usd_1')]),
    priceUsd1k: num(c[idx('price_usd_1k')]),
  };
});

const groups: Array<{ key: string; label: string }> = [
  { key: 'pcb',        label: 'Main PCB' },
  { key: 'satellite',  label: 'Satellite breakout' },
  { key: 'mechanical', label: 'Mechanical · battery · filament' },
];

function lineTotal(r: BomRow, qty: 1 | 1000): number | null {
  const p = qty === 1 ? r.priceUsd1 : r.priceUsd1k;
  return p == null ? null : p * r.qtyPerUnit;
}

function groupSummary(groupKey: string, qty: 1 | 1000) {
  const items = rows.filter((r) => r.group === groupKey);
  let total = 0;
  let complete = items.length > 0;
  for (const r of items) {
    const lt = lineTotal(r, qty);
    if (lt == null) complete = false;
    else total += lt;
  }
  return { total, complete };
}

const totalsQty1 = groups.map((g) => groupSummary(g.key, 1));
const totalsQty1k = groups.map((g) => groupSummary(g.key, 1000));
const grandQty1 = totalsQty1.reduce((a, t) => a + t.total, 0);
const grandQty1k = totalsQty1k.reduce((a, t) => a + t.total, 0);
const qty1Complete = totalsQty1.every((t) => t.complete);
const qty1kComplete = totalsQty1k.every((t) => t.complete);

function fmtPrice(n: number | null): string {
  return n == null ? '—' : n.toFixed(2);
}

const downloads = [
  { title: 'KiCad project',     meta: 'hardware/ · v8',                   href: `${TREE}/hardware` },
  { title: 'Gerbers + drill',   meta: 'hardware/gerbers/ · 2-layer',      href: `${TREE}/hardware/gerbers` },
  { title: 'Enclosure STL',     meta: 'hardware/3dmodels/Enclosure/STL/', href: `${TREE}/hardware/3dmodels/Enclosure/STL` },
  { title: 'Firmware source',   meta: 'firmware/STM32CubeIDE/InfusionBA2', href: `${TREE}/firmware/STM32CubeIDE/InfusionBA2` },
  { title: 'Validation dataset',meta: 'data/raw/ · Zenodo on submission', href: `${TREE}/data/raw` },
  { title: 'Analysis notebook', meta: 'analysis/notebooks/validation.ipynb', href: `${BLOB}/analysis/notebooks/validation.ipynb` },
];
---
<section id="build">
  <div class="eyebrow">Reproduce</div>
  <h2>Build it yourself.</h2>
  <p class="lead">
    Single Docker command regenerates every figure in this page from the raw
    CSVs in the Zenodo deposit. Hardware files are KiCad 8 native; firmware
    builds on STM32CubeIDE 1.16; enclosure prints in ASA on a 0.4 mm nozzle.
  </p>

  <div class="build-grid">
    <div class="bom-card" data-qty="1">
      <div class="bom-head">
        <h3>Bill of materials</h3>
        <div class="qty-toggle" role="group" aria-label="Quantity tier">
          <button type="button" class="qty-btn active" data-qty-target="1">qty 1</button>
          <button type="button" class="qty-btn" data-qty-target="1000">qty 1000</button>
        </div>
      </div>
      <table class="bom-table">
        <thead>
          <tr>
            <th>Ref</th>
            <th>Description</th>
            <th>MPN</th>
            <th class="num">Qty</th>
            <th class="num col-1">USD · qty 1</th>
            <th class="num col-1k">USD · qty 1000</th>
          </tr>
        </thead>
        <tbody>
          {groups.map((g, gi) => (
            <>
              <tr class="bom-group"><td colspan="6">{g.label}</td></tr>
              {rows.filter((r) => r.group === g.key).map((r) => (
                <tr>
                  <td>{r.ref || '—'}</td>
                  <td>
                    {r.description}
                    {r.category && <span class="bom-tag">{r.category}</span>}
                  </td>
                  <td><code>{r.mfgPn || '—'}</code></td>
                  <td class="num">{r.qtyPerUnit}</td>
                  <td class="num col-1">{fmtPrice(r.priceUsd1)}</td>
                  <td class="num col-1k">{fmtPrice(r.priceUsd1k)}</td>
                </tr>
              ))}
              <tr class="bom-subtotal">
                <td colspan="4">Subtotal · {g.label}</td>
                <td class="num col-1">{totalsQty1[gi].complete ? `$${totalsQty1[gi].total.toFixed(2)}` : '—'}</td>
                <td class="num col-1k">{totalsQty1k[gi].complete ? `$${totalsQty1k[gi].total.toFixed(2)}` : '—'}</td>
              </tr>
            </>
          ))}
          <tr class="bom-grand">
            <td colspan="4"><strong>Estimated unit cost</strong></td>
            <td class="num col-1"><strong>{qty1Complete ? `$${grandQty1.toFixed(2)}` : `≈ $${grandQty1.toFixed(2)}`}</strong></td>
            <td class="num col-1k"><strong>{qty1kComplete ? `$${grandQty1k.toFixed(2)}` : '— (quotes pending)'}</strong></td>
          </tr>
        </tbody>
      </table>
      <div class="bom-foot">
        <p class="bom-callout">
          <strong>The table above is a component-only BOM</strong> — it does not include JLCPCB PCBA
          assembly fees, per-Extended-part surcharges, stencil cost, or shipping. The actual 2026-04-23
          order <code>Y9-9959576A</code> totalled <strong>$99.06 USD for 5 boards (the JLCPCB MOQ)</strong>
          — ≈ $19.81 per delivered SMD-assembled PCB. The LCD and the three tactile switches were
          excluded from PCBA and ordered separately on a 2026-04-02 DigiKey invoice
          (LCD CHF 6.45 each, PTS647 CHF 0.182 each); the IR LEDs / photodiodes / FFC cable also came
          from that DigiKey order. Adding the headless PCB ($19.81) + DigiKey LCD ($7.17) + 3 hand-
          soldered switches ($0.61) + satellite breakout + IR LEDs + photodiodes + bezels ($3.40) +
          mechanical / battery / FFC / filament ($5.73), the <strong>real per-device build cost at
          qty=1 = qty=5 ≈ $36.72 USD</strong>. The JLCPCB minimum order is 5 boards, so a single-device
          reproducer pays the same per-unit price as one building 5. The table itself stays
          component-only for design transparency and rubric convention.
        </p>
        <p>
          Source: <a href={BOM_CSV_URL} rel="noopener"><code>hardware/bom.csv.new</code></a>. PCB qty=1
          prices are USD per piece from LCSC retail (the per-piece sums match the Y9-9959576A
          parts-list line totals, $22.85 across 27 lines for 5 boards). Satellite + mechanical qty=1
          prices are real CHF receipts converted to USD at FX 0.90. <strong>qty=1000 prices are
          estimates</strong>: ~50 % of LCSC qty=1 for Extended ICs (STM32, TPS61098, photodiode, IR LED),
          unchanged for LCSC Basic parts, $0.30 for JLCPCB fab at qty=1000, $0.50 for the AA holder
          bulk, slight discount on ASA filament. Each estimated row is flagged in its <code>notes</code>
          column. Rev-C cost-reduction levers (bulk DOGS164, power-chain options) live in
          <a href={`${BLOB}/docs/limitations.md`}>docs/limitations.md</a> and the open ADRs.
        </p>
      </div>
    </div>

    <script is:inline>
      document.querySelectorAll('.bom-card').forEach((card) => {
        const btns = card.querySelectorAll('.qty-btn');
        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const target = btn.getAttribute('data-qty-target');
            if (!target) return;
            card.setAttribute('data-qty', target);
            btns.forEach((b) => b.classList.toggle('active', b === btn));
          });
        });
      });
    </script>

    <style>
      .bom-card { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; }
      .bom-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 14px; flex-wrap: wrap; }
      .bom-head h3 { margin: 0; }
      .qty-toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; gap: 2px; background: var(--bg-3); }
      .qty-btn { font-family: var(--mono); font-size: 12px; padding: 5px 12px; border-radius: 999px; border: 0; background: transparent; color: var(--fg-mute); cursor: pointer; transition: background 120ms ease, color 120ms ease; }
      .qty-btn:hover { color: var(--fg); }
      .qty-btn.active { background: var(--ir); color: #0d1117; }
      .bom-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
      .bom-table th, .bom-table td { padding: 7px 8px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
      .bom-table th { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--fg-mute); font-weight: 500; }
      .bom-table .num { text-align: right; font-variant-numeric: tabular-nums; }
      .bom-table code { font-family: var(--mono); font-size: 12px; color: var(--fg-dim); }
      .bom-tag { display: inline-block; margin-left: 8px; padding: 1px 6px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .04em; border: 1px solid var(--line); border-radius: 4px; color: var(--fg-mute); }
      tr.bom-group td { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--ir); padding-top: 14px; border-bottom: 1px solid var(--ir); }
      tr.bom-subtotal td { color: var(--fg-mute); font-size: 12.5px; border-top: 1px dashed var(--line); border-bottom: 1px solid var(--line); }
      tr.bom-grand td { border-top: 2px solid var(--line-2); border-bottom: 0; padding-top: 14px; }
      .bom-card[data-qty="1"]   .col-1k { display: none; }
      .bom-card[data-qty="1000"] .col-1  { display: none; }
      .bom-foot { margin-top: 14px; font-size: 13px; color: var(--fg-dim); line-height: 1.55; }
      .bom-foot p + p { margin-top: 12px; }
      .bom-foot code { font-family: var(--mono); font-size: 12.5px; background: var(--bg-3); padding: 1px 5px; border-radius: 4px; }
      .bom-callout { padding: 14px 16px; background: var(--bg-3); border-left: 3px solid var(--ir); border-radius: 0 6px 6px 0; color: var(--fg); }
    </style>

    <div>
      <h3>Downloads</h3>
      <div class="download-grid">
        {downloads.map((d) => (
          <a class="dl" href={d.href} rel="noopener">
            <span class="dl-title">{d.title}</span>
            <span class="dl-meta">{d.meta}</span>
          </a>
        ))}
      </div>

      <h3 style="margin-top: 36px;">Reproduce in one command</h3>
      <pre class="code-block"><span class="prompt">$</span> git clone https://github.com/Gluflex/iv-flow-monitor-v2
<span class="prompt">$</span> cd iv-flow-monitor-v2/analysis
<span class="prompt">$</span> docker compose up regenerate-figures-sample   <span class="ok"># cold-clone test (sample data)</span>
<span class="prompt">$</span> docker compose up regenerate-figures          <span class="ok"># full campaign data</span>
<span class="ok"># → analysis/figures/fig_error_budget.png</span>
<span class="ok"># → analysis/figures/fig_error_budget_with_bench.png</span></pre>

      <p style="margin-top: 18px;">
        Pipeline source: <a href={`${BLOB}/analysis/notebooks/validation.ipynb`}>analysis/notebooks/validation.ipynb</a>.
        Dependencies hash-locked in <a href={`${BLOB}/analysis/requirements.txt`}>analysis/requirements.txt</a>.
      </p>
    </div>
  </div>
</section>
