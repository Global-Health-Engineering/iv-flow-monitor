---
const projectLinks = [
  { label: 'Documentation',     href: '/docs/' },
  { label: 'Design decisions',  href: '/docs/decisions/' },
  { label: 'Limitations',       href: '/docs/limitations.html' },
  { label: 'Recommendations',   href: '/docs/recommendations.html' },
];

const codeLinks = [
  { label: 'GitHub repository', href: 'https://github.com/Gluflex/iv-flow-monitor-v2' },
  { label: 'Zenodo dataset',    href: 'https://doi.org/10.5281/zenodo.16902366' },
  { label: 'CI · GitHub Actions', href: '#' },
  { label: 'Issue tracker',     href: '#' },
];

const ack = [
  'Jakub Tkaczuk · supervisor',
  'Prof. Elizabeth Tilley · examiner',
  'Dr. Janis Tupesis · WHO EMT consult',
  'Hangar makerspace · ETH',
];
---
<footer>
  <div>
    <h4>Dripito</h4>
    <p style="font-size: 14px;">
      An ETH Global Health Engineering MSc semester project. Open-source under
      MIT (firmware) and CERN-OHL-W (hardware + enclosure).
    </p>
    <p style="font-family: var(--mono); font-size: 12px; color: var(--fg-mute); margin-top: 8px;">
      Cite: Catarci, L. (2026). Dripito v1.0. Zenodo. <a href="#">10.5281/zenodo.16902366</a>
    </p>
  </div>
  <div>
    <h4>Project</h4>
    <ul>
      {projectLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
  <div>
    <h4>Code &amp; data</h4>
    <ul>
      {codeLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
  <div>
    <h4>Acknowledgements</h4>
    <ul>
      {ack.map((a) => <li>{a}</li>)}
    </ul>
  </div>
  <div class="cite">
    <span>build pre-release · commit hash populated by CI on tag</span>
    <span>© 2026 Leandro Catarci · CC-BY 4.0 (docs)</span>
  </div>
</footer>
