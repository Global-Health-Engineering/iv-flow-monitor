---
const REPO = 'https://github.com/Gluflex/dripito';
const BLOB = `${REPO}/blob/v2`;
const TREE = `${REPO}/tree/v2`;

const projectLinks = [
  { label: 'Documentation',     href: `${TREE}/docs` },
  { label: 'Design decisions',  href: `${TREE}/docs/decisions` },
  { label: 'Limitations',       href: `${BLOB}/docs/limitations.md` },
  { label: 'Results',           href: `${BLOB}/docs/results.md` },
];

const codeLinks = [
  { label: 'GitHub repository', href: REPO },
  { label: 'Bachelor thesis (Zenodo)', href: 'https://doi.org/10.5281/zenodo.16902366' },
  { label: 'CI · GitHub Actions', href: `${REPO}/actions` },
  { label: 'Issue tracker',     href: `${REPO}/issues` },
];

const ack = [
  'Jakub Tkaczuk · supervisor',
  'Prof. Elizabeth Tilley · examiner',
  'Dr. Michelle Niescierenko · project originator (Boston Children\'s Hospital / Harvard Humanitarian Initiative)',
  'Dr. Janis Tupesis · clinical collaborator (University of Wisconsin / WHO EMT)',
];
---
<footer>
  <div>
    <h4>Dripito</h4>
    <p style="font-size: 14px;">
      An ETH Global Health Engineering MSc semester project. Open-source under
      CC BY 4.0 (code, firmware, docs, data) and CERN-OHL-P 2.0 (hardware + enclosure).
    </p>
    <p style="font-family: var(--mono); font-size: 12px; color: var(--fg-mute); margin-top: 8px;">
      Rev-B dataset DOI: 10.5281/zenodo.TBD — minted post-submission. Bachelor thesis baseline:
      <a href="https://doi.org/10.5281/zenodo.16902366" rel="noopener">10.5281/zenodo.16902366</a>.
    </p>
  </div>
  <div>
    <h4>Project</h4>
    <ul>
      {projectLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
  <div>
    <h4>Code &amp; data</h4>
    <ul>
      {codeLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
  <div>
    <h4>Acknowledgements</h4>
    <ul>
      {ack.map((a) => <li>{a}</li>)}
    </ul>
  </div>
  <div class="cite">
    <span>Snapshot · v1.0-submission-2026-05-14</span>
    <span>© 2026 Leandro Catarci · CC BY 4.0 (docs)</span>
  </div>
</footer>
