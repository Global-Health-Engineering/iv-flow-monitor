---
---
<div class="power-tree">
  <h3>Power tree</h3>
  <svg class="tree-svg" viewBox="0 0 1100 280" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 z" fill="#6b7480" />
      </marker>
    </defs>

    <g>
      <rect x="20" y="120" width="140" height="50" rx="6" fill="#11151b" stroke="#ff6b35" stroke-width="1.5"/>
      <text x="90" y="145" fill="#e6e8eb" font-family="ui-sans-serif" font-size="13" text-anchor="middle" font-weight="600">Li-ion AA</text>
      <text x="90" y="161" fill="#9aa3ad" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">1.5 V nom · 0.9 V EOD</text>
    </g>

    <g>
      <rect x="220" y="120" width="160" height="50" rx="6" fill="#11151b" stroke="#1f2630"/>
      <text x="300" y="145" fill="#e6e8eb" font-family="ui-sans-serif" font-size="13" text-anchor="middle" font-weight="600">TPS610981</text>
      <text x="300" y="161" fill="#9aa3ad" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">boost · 3.3 V · 80% η</text>
    </g>
    <line x1="160" y1="145" x2="218" y2="145" stroke="#6b7480" stroke-width="1.5" marker-end="url(#arrow)"/>

    <g>
      <rect x="440" y="120" width="120" height="50" rx="6" fill="#11151b" stroke="#06b6d4" stroke-width="1.5"/>
      <text x="500" y="145" fill="#e6e8eb" font-family="ui-sans-serif" font-size="13" text-anchor="middle" font-weight="600">3.3 V rail</text>
      <text x="500" y="161" fill="#9aa3ad" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">measured 3.297 V</text>
    </g>
    <line x1="380" y1="145" x2="438" y2="145" stroke="#6b7480" stroke-width="1.5" marker-end="url(#arrow)"/>

    <g>
      <rect x="640" y="20" width="180" height="44" rx="6" fill="#11151b" stroke="#1f2630"/>
      <text x="730" y="40" fill="#e6e8eb" font-family="ui-sans-serif" font-size="12" text-anchor="middle">STM32G071 + COMP1</text>
      <text x="730" y="55" fill="#9aa3ad" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">~6 µA stop / ~3 mA active</text>
    </g>
    <g>
      <rect x="640" y="80" width="180" height="44" rx="6" fill="#11151b" stroke="#1f2630"/>
      <text x="730" y="100" fill="#e6e8eb" font-family="ui-sans-serif" font-size="12" text-anchor="middle">DOGS164W-A LCD</text>
      <text x="730" y="115" fill="#9aa3ad" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">~250 µA · no backlight</text>
    </g>
    <g>
      <rect x="640" y="140" width="180" height="44" rx="6" fill="#11151b" stroke="#1f2630"/>
      <text x="730" y="160" fill="#e6e8eb" font-family="ui-sans-serif" font-size="12" text-anchor="middle">IR LED pair</text>
      <text x="730" y="175" fill="#9aa3ad" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">Phase 1: 8.3% · Phase 2: 0.3%</text>
    </g>
    <g>
      <rect x="640" y="200" width="180" height="44" rx="6" fill="#11151b" stroke="#1f2630"/>
      <text x="730" y="220" fill="#e6e8eb" font-family="ui-sans-serif" font-size="12" text-anchor="middle">ADC_V_BAT divider</text>
      <text x="730" y="235" fill="#9aa3ad" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">PB2 · battery indicator</text>
    </g>

    <line x1="560" y1="145" x2="638" y2="42"  stroke="#6b7480" stroke-width="1.5" marker-end="url(#arrow)"/>
    <line x1="560" y1="145" x2="638" y2="102" stroke="#6b7480" stroke-width="1.5" marker-end="url(#arrow)"/>
    <line x1="560" y1="145" x2="638" y2="162" stroke="#6b7480" stroke-width="1.5" marker-end="url(#arrow)"/>
    <line x1="560" y1="145" x2="638" y2="222" stroke="#6b7480" stroke-width="1.5" marker-end="url(#arrow)"/>

    <g>
      <rect x="880" y="100" width="200" height="80" rx="6" fill="#0d2a1a" stroke="#34d399"/>
      <text x="980" y="125" fill="#e6e8eb" font-family="ui-sans-serif" font-size="13" text-anchor="middle" font-weight="600">Runtime target</text>
      <text x="980" y="145" fill="#34d399" font-family="ui-monospace,monospace" font-size="14" text-anchor="middle">≥ 14 days</text>
      <text x="980" y="162" fill="#9aa3ad" font-family="ui-monospace,monospace" font-size="10" text-anchor="middle">pending bench validation</text>
    </g>
  </svg>
</div>
