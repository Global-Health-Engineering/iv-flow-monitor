---
const topics = [
  {
    code: 'T1',
    tag: 'Mechanical',
    title: 'Casing & mounting redesign',
    body: 'Verticality budget (drop detection collapses with sub-mm chamber tilt — see §4); chamber-clip force on worn or softer drip chambers (un-quantified for used sets); mount geometry that pins drip-orifice-to-TOP-beam distance so §17 mount-position contamination disappears by construction. Field-deployment unblocker. CAD + bench testing, no firmware change.',
  },
  {
    code: 'T2',
    tag: 'Software',
    title: 'Algorithm test bench',
    body: 'Open-loop framework that ingests raw photodiode CSVs (2026-05-13 PM dataset + any future captures), sweeps algorithm variants — threshold rules, peak detectors, splash compensators — and scores cross-position residual on a held-out positions test set. Turns algorithm design from artisanal probing into measurable comparison. Will likely refute most variants quickly (§17 already names eight that fail), but the framework itself is the contribution: Rev-C silicon will need it for re-tuning anyway.',
  },
  {
    code: 'T3',
    tag: 'Hardware',
    title: 'Rev-C optics overhaul',
    body: 'Horizontal-pair beams catching drop horizontal extent (recovers oscillation phase, removes the §1 physics floor); wider TOP-BOT separation past detachment (removes umbilical contaminant from §17); TOP/BOT gain equalisation (closes baseline-drift contaminant). One PCB spin. Bring-up verifies the deferred Rev-B power-chain items: TPS610981 end-of-discharge under load, IR-LED ageing margin on the Phase-2 schedule. The silicon-spin §§1, 3, 17 all jointly motivate.',
  },
  {
    code: 'T4',
    tag: 'Embedded',
    title: 'Multi-channel architecture',
    body: 'One MCU + N satellite breakouts for the parallel-infusions reality of PICU patients. Rev-B is single-channel by design; multi-channel expands the safety case considerably (alarm prioritisation across channels, per-channel calibration storage, FFC harness for chamber spacing). Embedded-systems thesis with a real-time-scheduling and safety-case dimension on top of the hardware lift.',
  },
  {
    code: 'T5',
    tag: 'Research',
    title: 'Clinician-driven accuracy specification',
    body: 'The 2025 P1+P2 nurse interviews at Kinderspital Zürich gave a binary trust taxonomy (yes for fluids and antibiotics, no for anesthetic agents) but never asked how many ± % is acceptable per use case. Tate 2023 and NICE NG29 don\'t quantify it either. A structured interview campaign with humanitarian field operators (Till Haeussner & Gian Teufen — Malawi, 20 health centres, 3-month deployment), MSF clinical (Michelle Niescierenko), and clinical engineering (Rebecca Alcock) would turn "is this accurate enough?" into a per-use-case ± % spec sheet. Rev-C is then designed to that spec rather than against an arbitrary ±5 %. Pure-research thesis, semester-scoped.',
  },
];

const decision = [
  { cond: 'No board access?',           route: 'T1, T2, or T5.' },
  { cond: 'Can spin a board?',          route: 'T3.' },
  { cond: 'Embedded systems student?',  route: 'T4.' },
];
---

<section id="future-work">
  <div class="eyebrow">Where do we go from here</div>
  <h2>Continuation thesis topics.</h2>
  <p class="lead">
    Five projects another student could pick up after Rev-B. Each is
    scoped for a one-semester thesis. The decision strip at the bottom
    routes by hardware access.
  </p>

  <div class="topics-grid">
    {topics.map((t) => (
      <div class="topic">
        <div class="topic-head">
          <span class="topic-code">{t.code}</span>
          <span class={`topic-tag topic-tag-${t.tag.toLowerCase()}`}>{t.tag}</span>
        </div>
        <h3>{t.title}</h3>
        <p>{t.body}</p>
      </div>
    ))}
  </div>

  <div class="decision-strip">
    <div class="decision-label">Pick a route</div>
    <ul>
      {decision.map((d) => (
        <li><strong>{d.cond}</strong> <span class="arrow">→</span> {d.route}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  #future-work {
    padding-top: 56px;
    padding-bottom: 56px;
  }
  #future-work h2 {
    font-family: var(--serif);
    font-size: 40px;
    line-height: 1.1;
    max-width: 22ch;
    margin: 0 0 18px;
  }
  #future-work a {
    color: var(--ir);
    text-decoration: none;
  }
  #future-work a:hover { text-decoration: underline; }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin: 36px 0 32px;
  }
  .topic {
    padding: 22px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .topic-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .topic-code {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--fg);
  }
  .topic-tag {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: .08em;
    padding: 2px 7px;
    border-radius: 4px;
    border: 1px solid var(--line);
    color: var(--fg-mute);
  }
  .topic-tag-mechanical { color: #577590;     border-color: #577590; }
  .topic-tag-software   { color: var(--flow); border-color: var(--flow); }
  .topic-tag-hardware   { color: var(--ir);   border-color: var(--ir); }
  .topic-tag-embedded   { color: #f4a261;     border-color: #f4a261; }
  .topic-tag-research   { color: var(--fg-mute); }

  .topic h3 {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.25;
    margin: 0 0 10px;
    color: var(--fg);
  }
  .topic p {
    color: var(--fg-dim);
    font-size: 14.5px;
    line-height: 1.6;
    margin: 0;
  }

  .decision-strip {
    margin-top: 16px;
    padding: 18px 22px;
    background: var(--bg-3);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .decision-label {
    font-family: var(--mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--flow);
    margin-bottom: 10px;
  }
  .decision-strip ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .decision-strip li {
    color: var(--fg-dim);
    font-size: 14px;
    line-height: 1.55;
  }
  .decision-strip strong { color: var(--fg); font-weight: 600; }
  .decision-strip .arrow { color: var(--ir); }

  @media (max-width: 720px) {
    .topics-grid { grid-template-columns: 1fr; }
    #future-work h2 { font-size: 30px; }
  }
</style>
