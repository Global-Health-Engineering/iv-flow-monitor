---
const stats = [
  {
    num: 'CHF 11',
    label: 'estimated component BOM at qty=1000 (first-prototype unit ≈ CHF 33). Compatible with any standard IV drip set — macro (10 / 15 / 20 gtt·mL⁻¹) and micro (60 gtt·mL⁻¹).',
    source: { text: '§ Build it yourself (BOM)', href: '#build' },
  },
  {
    num: '119 days',
    label: 'design-target standby on a single alkaline AA cell (Phase 2 sleep + comparator wake, Rev-C). Rev-B firmware today runs ~19 h actively-monitoring before swap. Field-deployable in clinics without reliable mains or USB charging.',
    source: { text: '§ Dual-beam (power budget)', href: '#dual-beam' },
  },
  {
    num: '73 %',
    label: 'of surveyed Sub-Saharan African neonatal facilities lack reliable infusion-pump access (none or limited). Manual gravity drip is the default — flow set by hand-counting drops, no electronic monitoring.',
    source: {
      text: 'Tate et al. 2023, rapid review (n = 30 facilities)',
      href: 'https://pmc.ncbi.nlm.nih.gov/articles/PMC9834926/',
    },
  },
];
---
<section id="problem">
  <div class="eyebrow">The problem</div>
  <h2>Pediatric IV delivery is silently dangerous in low-resource settings.</h2>
  <p class="lead">
    Gravity-fed IV drips are the default in humanitarian and rural healthcare.
    Without an infusion pump, flow rate is set by hand-counted drops — and a
    single missed adjustment can deliver a fatal volume to a child in under an
    hour.
  </p>
  <div class="lead-source">
    Source: <a href="https://www.nice.org.uk/guidance/ng29" rel="noopener noreferrer">NICE NG29 — Intravenous fluid therapy in children and young people in hospital</a>
  </div>

  <div class="problem-stats">
    {stats.map((s) => (
      <div class="stat">
        <div class="num">{s.num}</div>
        <div class="label">{s.label}</div>
        {s.source && (
          <div class="stat-source">
            Source: <a href={s.source.href} rel="noopener noreferrer">{s.source.text}</a>
          </div>
        )}
      </div>
    ))}
  </div>

  <style>
    .stat-source,
    .lead-source {
      font-family: var(--mono);
      font-size: 11.5px;
      color: var(--fg-mute);
      letter-spacing: .01em;
    }
    .stat-source { margin-top: 10px; }
    .lead-source { margin-top: -8px; margin-bottom: 22px; max-width: 68ch; }
    .stat-source a,
    .lead-source a { color: var(--fg-mute); text-decoration: underline; text-decoration-color: var(--line); }
    .stat-source a:hover,
    .lead-source a:hover { color: var(--fg); text-decoration-color: var(--fg-mute); }
  </style>
</section>
