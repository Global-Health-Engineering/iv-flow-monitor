---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dripito — Open-source IV drip flow monitor',
  description = 'Open-source IV drip flow monitor for pediatric humanitarian care. Dual-beam optical drop detection on STM32G0.',
} = Astro.props;
---
<!doctype html>
<html lang="en" data-base-url={import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <slot />
  </body>
</html>
